<Window x:Class="ubuntu_wg_patcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ubuntu_wg_patcher"
        mc:Ignorable="d"
        Title="Remote Ubuntu WireGuard Patch" Height="680" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1f2937" Padding="12">
            <TextBlock Text="Remote Ubuntu WireGuard Patch" Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Content: configurations list on the far left, form in the middle, logs on the right -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Far left: configurations management -->
            <Border Grid.Column="0" Padding="12" Background="#FFFFFF" CornerRadius="6" BorderBrush="#e5e7eb" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Конфигурации" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Configs}"
                              SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding ConfigName}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding ConfigType}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="+" Width="40" Height="28" Command="{Binding CreateConfigCommand}"/>
                        <Button Content="-" Width="40" Height="28" Margin="8,0,0,0" Command="{Binding DeleteConfigCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Middle: form (always visible) -->
            <Border Grid.Column="2" Padding="12" Background="#FFFFFF" CornerRadius="6" BorderBrush="#e5e7eb" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Config name -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Config type -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Section header -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <!-- WG Port -->
                        <RowDefinition Height="Auto"/> <!-- Disable IPv6 on its own row -->
                        <RowDefinition Height="Auto"/> <!-- Peers count on its own row -->
                        <RowDefinition Height="Auto"/> <!-- Export path -->
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- New: Config name -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Width="160" HorizontalAlignment="Left" Text="{Binding SelectedConfig.ConfigName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <!-- New: Config type -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Type" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Width="160" HorizontalAlignment="Left" ItemsSource="{Binding ConfigTypes}" SelectedItem="{Binding SelectedConfig.ConfigType, Mode=TwoWay}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Connection" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Host/IP" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Width="160" HorizontalAlignment="Left" Text="{Binding SelectedConfig.Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="SSH Port" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Width="160" HorizontalAlignment="Left" Text="{Binding SelectedConfig.Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Login" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Width="160" HorizontalAlignment="Left" Text="{Binding SelectedConfig.Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Width="160" HorizontalAlignment="Left" Text="{Binding SelectedConfig.Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="WG Port (UDP)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Width="160" HorizontalAlignment="Left" Text="{Binding SelectedConfig.WgPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <!-- IPv6 on its own row -->
                    <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="Disable IPv6" IsChecked="{Binding SelectedConfig.DisableIPv6}" VerticalAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Peers count row -->
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Peers count" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="9" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding SelectedConfig.Peers, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Export folder" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="200" HorizontalAlignment="Left" Text="{Binding SelectedConfig.ExportPath, UpdateSourceTrigger=PropertyChanged}" MinWidth="160"/>
                        <Button Width="34" Height="28" Margin="8,0,0,0" Command="{Binding BrowseExportPathCommand}" ToolTip="Select export folder">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Open export folder (moved here as requested) -->
                        <Button Width="34" Height="28" Margin="8,0,0,0" Command="{Binding OpenExportFolderCommand}" ToolTip="Open export folder">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Spacer row pushes buttons to bottom -->
                    <Grid Grid.Row="11" Grid.ColumnSpan="2"/>

                    <!-- Bottom-left action buttons: vertical stack -->
                    <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Vertical" HorizontalAlignment="Left">
                        <Button Content="Smoke" Width="140" Height="30" Command="{Binding SmokeCommand}"/>
                        <Button Content="Take d.compose" Width="140" Height="30" Margin="0,8,0,0" Command="{Binding TakeComposeCommand}"/>
                        <Button Content="GetWgFolder" Width="140" Height="30" Margin="0,8,0,0" Command="{Binding GetWgFolderCommand}"/>
                        <Button Content="Save" Width="140" Height="32" Margin="0,16,0,0" Command="{Binding SaveAllCommand}"/>
                        <Button Content="START" Width="140" Height="36" Margin="0,8,0,0" Command="{Binding StartCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: logs DataGrid -->
            <Border Grid.Column="4" Padding="12" Background="#FFFFFF" CornerRadius="6" BorderBrush="#e5e7eb" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Log" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Очистить логи" Width="120" Height="26" Command="{Binding ClearLogsCommand}"/>
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding LogEntries}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="Auto"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                                <Setter Property="Foreground" Value="#f59e0b"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Command">
                                        <Setter Property="Foreground" Value="#3b82f6"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                        <Setter Property="Foreground" Value="#10b981"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="SuccessMsg">
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="Background" Value="#86efac"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                        <Setter Property="Foreground" Value="#ef4444"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Fatal">
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="Background" Value="#ef4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="80"/>
                            <DataGridTemplateColumn Header="Message" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LogFilePath, StringFormat=Log file: {0}}" Foreground="#6b7280" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Open logs" Margin="8,0,0,0" Width="110" Height="28" Command="{Binding OpenLogsFolderCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
