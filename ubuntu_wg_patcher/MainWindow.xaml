<Window x:Class="ubuntu_wg_patcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ubuntu_wg_patcher"
        mc:Ignorable="d"
        Title="Remote Ubuntu WireGuard Patch" Height="560" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1f2937" Padding="12">
            <TextBlock Text="Remote Ubuntu WireGuard Patch" Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Content: always-visible form on the left, logs on the right -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="680"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: form (always visible) -->
            <Border Grid.Column="0" Padding="12" Background="#FFFFFF" CornerRadius="6" BorderBrush="#e5e7eb" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Connection" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Host/IP" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SSH Port" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Login" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="WG Port (UDP)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding WgPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="Disable IPv6" IsChecked="{Binding DisableIPv6}" VerticalAlignment="Center"/>
                        <TextBlock Text="  |  Peers count:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox Width="80" Text="{Binding Peers, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Export folder" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="360" Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" MinWidth="280"/>
                        <Button Width="34" Height="28" Margin="8,0,0,0" Command="{Binding BrowseExportPathCommand}" ToolTip="Select export folder">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Spacer row (Row 8) pushes buttons to bottom -->
                    <Grid Grid.Row="8" Grid.ColumnSpan="2"/>

                    <!-- Bottom-right action buttons -->
                    <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Save" Width="100" Height="32" Command="{Binding SaveTempCommand}"/>
                        <Button Content="Open folder" Margin="8,0,0,0" Width="120" Height="32" Command="{Binding OpenExportFolderCommand}"/>
                        <Button Content="START" Margin="8,0,0,0" Width="120" Height="36" Command="{Binding StartCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: logs DataGrid -->
            <Border Grid.Column="2" Padding="12" Background="#FFFFFF" CornerRadius="6" BorderBrush="#e5e7eb" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Log" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding LogEntries}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="Auto"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                                <Setter Property="Foreground" Value="#f59e0b"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Command">
                                        <Setter Property="Foreground" Value="#3b82f6"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                        <Setter Property="Foreground" Value="#10b981"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="SuccessMsg">
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="Background" Value="#86efac"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                        <Setter Property="Foreground" Value="#ef4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="80"/>
                            <DataGridTemplateColumn Header="Message" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LogFilePath, StringFormat=Log file: {0}}" Foreground="#6b7280" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Open logs" Margin="8,0,0,0" Width="110" Height="28" Command="{Binding OpenLogsFolderCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
